# Copy to .env and replace the password before starting.
SERVER_NAME='Private Valheim'
WORLD_NAME=Dedicated
# At least 5 characters; use a unique, long password, distinct from the server name.
# Single quotes preserve literal dollar signs in Docker Compose .env files.
SERVER_PASS='REPLACE_WITH_A_LONG_RANDOM_PASSWORD'
TZ=Asia/Manila
VALHEIM_IMAGE=ghcr.io/community-valheim-tools/valheim-server:latest
